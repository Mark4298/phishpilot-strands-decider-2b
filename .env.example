# Reference values; set these in the process environment before launch.
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Local Strands Decider server. Never expose this to the public internet.
PHISHPILOT_DECIDER_URL=http://127.0.0.1:8000
# Optional server model; omit to use the local server's configured default.
# PHISHPILOT_DECIDER_MODEL=StrandsAgents/your-model-id
# Overall text limit is configurable up to 20,000; each URL is capped at 4,096 chars.
# Email extraction accepts at most 10 URLs.
PHISHPILOT_MAX_TEXT_CHARS=20000
# Bounded local request timeout in seconds (0.05–120); 60 is a CPU-test candidate,
# not a guarantee that inference will finish in time.
PHISHPILOT_DECIDER_TIMEOUT_SECONDS=60
# Botocore read timeout (1–3600 seconds; default 3600); connect timeout remains 5 seconds.
PHISHPILOT_BEDROCK_TIMEOUT_SECONDS=3600
# Bounded report output budget (1–4096); default is 500 tokens.
PHISHPILOT_BEDROCK_MAX_TOKENS=500
# Never put AWS_BEARER_TOKEN_BEDROCK or any key value in this file.
# Demonstration uncertainty policy only; not calibrated phishing thresholds.
PHISHPILOT_MIN_DECIDER_CONFIDENCE=0.55
PHISHPILOT_MIN_DECIDER_MARGIN=0.05
